# Every variable this app reads. Copy to .env and fill in the real values.
# Never commit the filled-in .env.

PORT=3000

# ---- MTN MoMo ----
# In production these come from the MTN Partner Portal (https://momoapi.mtn.com)
# after your KYC is approved. Sandbox self-service keys will not work live.
SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=

# "sandbox" or "production"
MOMO_ENV=production

# The X-Target-Environment header. NOT the same as MOMO_ENV.
# MTN Rwanda = mtnrwanda. Sending "production" is rejected by MTN.
MOMO_TARGET_ENV=mtnrwanda

# RWF for MTN Rwanda. EUR is the only currency the sandbox accepts.
MOMO_CURRENCY=RWF
MOMO_BASE_URL=https://proxy.momoapi.mtn.com

# Full URL MoMo will POST to, including the /momo/callback path.
# The host must also be registered as the Provider Callback Host on the
# MTN Partner Portal when the API user is created.
CALLBACK_URL=https://mtn-payment-getway-api.onrender.com/momo/callback

# Long random string guarding the admin order routes.
ADMIN_API_KEY=

# Neon connection string (Neon dashboard > Connect). Use the pooled host.
DATABASE_URL=

# Leave empty unless the shop is hosted on a different domain than the API.
FRONTEND_ORIGIN=
