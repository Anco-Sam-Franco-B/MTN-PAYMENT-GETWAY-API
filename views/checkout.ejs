<%- include("partials/head", { title: "Checkout" }) %>

<h1>Checkout</h1>

<div id="checkout-root"
     data-currency="<%= currency %>"
     data-create-url="/orders"
     data-pay-url="/pay">
  <div id="cart-empty" class="empty" hidden>Your cart is empty. <a href="/">Pick something first.</a></div>
  <div id="cart-body" hidden>
    <table class="lines">
      <thead>
        <tr><th>Item</th><th>Price</th><th>Qty</th><th>Line total</th><th></th></tr>
      </thead>
      <tbody id="cart-lines"></tbody>
      <tfoot>
        <tr><th colspan="3">Total</th><th id="cart-total">0.00</th><th></th></tr>
      </tfoot>
    </table>

    <form id="checkout-form" class="form">
      <label>Full name
        <input type="text" name="customerName" maxlength="100" autocomplete="name" required>
      </label>
      <label>MoMo phone number
        <input type="tel" name="customerPhone" placeholder="0781234567" autocomplete="tel" required>
        <% if (isProduction) { %>
          <small class="muted">An MTN Rwanda number (078) with enough balance for <%= currency %>.</small>
        <% } else { %>
          <small class="muted">Sandbox: use <code>46733123450</code> to auto-approve.</small>
        <% } %>
      </label>
      <button class="button primary" type="submit" id="pay-button">Pay with MoMo</button>
      <p id="checkout-error" class="error" hidden></p>
    </form>
  </div>
</div>

<script src="/js/cart.js"></script>
<script src="/js/checkout.js"></script>
<%- include("partials/foot") %>
